#include <winresrc.h>

#define BRONCO_VERSION_MAJOR 0
#define BRONCO_VERSION_MINOR 1
#define BRONCO_VERSION_PATCH 0

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    BRONCO_VERSION_MAJOR, BRONCO_VERSION_MINOR, BRONCO_VERSION_PATCH, 0
    PRODUCTVERSION BRONCO_VERSION_MAJOR, BRONCO_VERSION_MINOR, BRONCO_VERSION_PATCH, 0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_DLL
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Bronco Project"
            VALUE "FileDescription",  "Bronco Overlay - Guild Wars 2"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "d3d11"
            VALUE "LegalCopyright",   "Copyright (C) Bronco Project"
            VALUE "OriginalFilename", "d3d11.dll"
            VALUE "ProductName",      "Bronco"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
